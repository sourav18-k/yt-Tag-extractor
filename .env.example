# GEMINI_API_KEY: Required only for Gemini AI Creator Tools.
# AI Studio automatically injects this at runtime from your secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional secondary passcode for /admin login.
# You can also sign in at /admin with your authorized Google account or set a passcode on first launch.
ADMIN_PASSCODE=

# Optional Integrations (NOT required to run or deploy ClipLens):
# Configure Razorpay (RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET)
# or Google AdSense (VITE_ADSENSE_CLIENT_ID, VITE_ADSENSE_BANNER_SLOT, ADSENSE_ACCOUNT_ID, ADSENSE_ACCESS_TOKEN)
# only when you are ready to accept paid subscriptions or display live AdSense ads.
